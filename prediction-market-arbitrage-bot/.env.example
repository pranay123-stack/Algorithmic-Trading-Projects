# Telegram alerts
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Discord alerts (webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Alerting: comma-separated list of enabled channels (telegram,discord)
ALERT_CHANNELS=telegram

# Minimum arbitrage spread (%) to trigger alert
MIN_ARB_SPREAD=1.0

# Market matching similarity threshold (0.0 - 1.0)
MATCH_THRESHOLD=0.82

# Polling interval in seconds
POLL_INTERVAL=30

# Embedding model for market matching
EMBEDDING_MODEL=all-MiniLM-L6-v2
